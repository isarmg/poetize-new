[Unit]
Description=Poetize server
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=poetize
Group=poetize
WorkingDirectory=/opt/poetize
Environment=POETIZE_ENV_FILE=/etc/poetize/poetize.env
ExecStart=/opt/poetize/bin/poetize-server
Restart=on-failure
RestartSec=5s
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
