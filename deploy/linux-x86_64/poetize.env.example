# Copy this file to poetize.env and change every value before starting.
SERVER_PORT=8081
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/poetize?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=poetize
SPRING_DATASOURCE_PASSWORD=change-this-database-password
POETRY_ADMIN_INITIAL_PASSWORD=change-this-admin-password
JAVA_OPTS=-Xms256m -Xmx512m
